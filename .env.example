# Copy this file to .env for local development:  cp .env.example .env
# .env is git-ignored. NEVER commit real secrets.

DATABASE_URL=postgres://artweb:artweb@localhost:5432/artweb
# Who can log in: email addresses, separated by commas. Real addresses only go
# in .env and in Vercel, never in this file (the repo is public).
ALLOWED_EMAILS=you@example.com,partner@example.com
# Optional: a fixed six-digit PIN per address, which logs that person in
# without an emailed code. "address:pin" pairs, separated by commas. These are
# only for your own computer; pick other ones for Vercel.
LOGIN_PINS=you@example.com:123456,partner@example.com:654321
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string-at-least-32-chars
APP_ENV=local
LOG_LEVEL=debug

# The mail server that sends the login codes. Leave these out locally: the code
# is then written to the API log (the terminal running `npm run dev`) instead.
# With Gmail: SMTP_USER is your address and SMTP_PASS an "app password", see
# docs/SETUP.md.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASS=
