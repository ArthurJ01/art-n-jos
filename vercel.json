{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run build --workspace apps/web && npm run build --workspace apps/api",
  "outputDirectory": "apps/web/dist",
  "regions": ["fra1"],
  "functions": {
    "api/index.js": {
      "maxDuration": 30
    }
  },
  "git": {
    "deploymentEnabled": false
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
